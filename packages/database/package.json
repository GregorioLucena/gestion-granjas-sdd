{
  "name": "@gestion-granjas/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/data-source.js",
  "types": "./dist/data-source.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/data-source.d.ts",
      "default": "./dist/data-source.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "default": "./dist/entities/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    }
  },
  "typesVersions": {
    "*": {
      "entities": ["dist/entities/index.d.ts"],
      "enums": ["dist/enums.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "db:migration:generate": "tsx ../../node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "db:migration:run": "tsx ../../node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "db:migration:revert": "tsx ../../node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "db:seed": "tsx src/seeds/run-seed.ts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
