# Entorno testing en Railway (rama git `testing`, despues del MR).
# No commitear valores reales. Pegar en Variables del servicio API.

# Postgres (Variable Reference). El path debe ser /gestion_granjas si esa es la base.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gestion_granjas
DATABASE_SSL=true

# API (NODE_ENV=production porque la imagen es de build, no de jest)
NODE_ENV=production
PORT=3001
JWT_SECRET=generate-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# URL publica de la web de testing (sin barra final)
CORS_ORIGIN=https://TU-WEB-TESTING.up.railway.app

# Web y API en hosts distintos de Railway
COOKIE_SAMESITE=none

# Seed siempre en testing. La clave del admin NO va en git: solo Variables de Railway.
RUN_SEED=true
DEV_USER_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=

# LLM en cloud: plantilla de reglas. Ollama es solo local.
LLM_PROVIDER=none
LLM_TIMEOUT_MS=20000
