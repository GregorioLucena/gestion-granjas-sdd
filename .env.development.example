# Desarrollo local
# Copiar: cp .env.development.example .env.development

# PostgreSQL (contenedor Docker en localhost:5432)
POSTGRES_USER=nombre_de_usuario
POSTGRES_PASSWORD=contraseña_de_la_base_de_datos
POSTGRES_DB=nombre_de_la_base_de_datos
DATABASE_URL=postgresql://nombre_de_usuario:contraseña_de_la_base_de_datos@localhost:5432/nombre_de_la_base_de_datos

# API
JWT_SECRET=change-me-generate-with-openssl
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
API_PORT=3001
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Asistente — redaccion LLM (opcional)
# none = solo plantilla de reglas (default)
# ollama = modelo local (requiere `ollama serve`)
# openai = API de OpenAI
LLM_PROVIDER=none
LLM_TIMEOUT_MS=20000
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# General
NODE_ENV=development
DEV_USER_EMAIL=email_del_usuario_admin
SEED_ADMIN_PASSWORD=contraseña_del_usuario_admin
