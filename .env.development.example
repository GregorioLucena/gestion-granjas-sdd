# Desarrollo local
# Copiar: cp .env.development.example .env.development

# PostgreSQL (contenedor Docker en localhost:5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gestion_granjas
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestion_granjas

# API
JWT_SECRET=change-me-generate-with-openssl
JWT_EXPIRES_IN=8h
API_PORT=3001
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# General
NODE_ENV=development
