# =============================================================================
# gestion-granjas — monorepo pnpm + NestJS + Next.js
# =============================================================================

# --- Dependencias ----------------------------------------------------------------
node_modules/
.pnpm-store/

# --- Builds y artefactos compilados ----------------------------------------------
dist/
.next/
out/
build/
*.tsbuildinfo

# --- Entorno (secretos / config local) ------------------------------------------
# Nunca commitear valores reales. Solo plantillas *.example
.env
.env.*
!.env.example
!.env.*.example

# --- Logs y debug ----------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tests y cobertura -----------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# --- Cache de herramientas -------------------------------------------------------
.turbo/
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.swc/

# --- Next.js / Vercel ------------------------------------------------------------
.vercel/

# --- TypeORM (generados localmente, no versionar) --------------------------------
# Migraciones SI se versionan; este patron es por si se genera fuera de src/migrations
# packages/database/src/migrations/  → NO ignorar (van al repo)

# --- Docker (overrides locales opcionales) ---------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml

# --- Sistema operativo -----------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editores e IDE --------------------------------------------------------------
# VS Code: ignorar config local; extensions.json puede versionarse si se agrega
.vscode/*
!.vscode/extensions.json

# JetBrains
.idea/

# Cursor: versionar reglas SDD (.cursor/rules), ignorar estado local del IDE
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# --- Certificados y secretos accidentales ----------------------------------------
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# --- Temporales ------------------------------------------------------------------
tmp/
temp/
*.tmp
*.swp
*~

# --- Package managers legacy (por si alguien los usa por error) ------------------
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


docs_curso/
