# Produccion (Railway u otro PaaS)
# No commitear valores reales. Copiar ideas a las Variables del servicio.

# Postgres (en Railway: Variable Reference a Postgres.DATABASE_URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gestion_granjas
DATABASE_SSL=true

# API
NODE_ENV=production
PORT=3001
JWT_SECRET=generate-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# URL publica de la web (sin barra final)
CORS_ORIGIN=https://TU-WEB.up.railway.app

# none = cookie same-site (mismo dominio). none = web y API en hosts distintos (Railway)
COOKIE_SAMESITE=none

# Seed al arrancar (idempotente). La clave del admin NO va en git.
# Definirla solo en Variables de Railway (servicio API).
RUN_SEED=true
DEV_USER_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=

# LLM en cloud: Ollama no aplica. none = plantilla de reglas.
LLM_PROVIDER=none
LLM_TIMEOUT_MS=20000
